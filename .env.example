# ---------------------------------------------------------------------------
# DDCPL Tender Monitor — Environment Configuration
# Copy to .env and customize
# ---------------------------------------------------------------------------

# Database
DATABASE_URL="postgresql://gem:gem@localhost:5432/gem_website?schema=public"

# Redis (caching, rate limiting, worker queue)
REDIS_URL="redis://localhost:6379"

# Authentication
JWT_SECRET="your-super-secret-jwt-secret-change-in-production"
# Generate with: openssl rand -base64 32
# Set to "false" if serving over plain HTTP (no TLS) — otherwise login cookies break
# AUTH_COOKIE_SECURE="true"
# Optional: lets external cron call POST /api/scan with "Authorization: Bearer <CRON_SECRET>"
# CRON_SECRET=""

# Application
NODE_ENV="development"
PORT=3000
NEXT_TELEMETRY_DISABLED=1

# GeM Source
SCAN_ENABLED=true
SOURCE_DEMO_MODE=true
SOURCE_DEMO_LIMIT=50
REQUEST_DELAY_MS=1250
SOURCE_CRON="*/10 * * * *"

# Scanning
SCAN_INTERVAL_MINUTES=10
RELEVANCE_THRESHOLD=40
DUPLICATION_WINDOW_HOURS=72
DEDUPE_WARM=true
REQUEST_TIMEOUT_MS=15000
MAX_CONCURRENT_REQUESTS=2
DAILY_REQUEST_LIMIT=800
RETRY_COUNT=4

# Negative keywords (auto-filtered)
NEGATIVE_KEYWORDS="photography,dslr,photographic,marriage photography,stock photo,wedding photography,portrait,studio,album,videography,camera rental,photo shoot,model,fashion photography"

# Document Collection
COLLECT_DOCUMENTS=true

# Notifications
ENABLE_EMAIL_ALERT=true
EMAIL_FROM="tender-monitor@ddcpl.internal"
NOTIFICATION_START_HOUR=8
NOTIFICATION_END_HOUR=22
MIN_RELEVANCE_FOR_ALERT=40

# Deadline alerts
DEADLINE_ALERT_24H=true
DEADLINE_ALERT_12H=true
DEADLINE_ALERT_3H=true

# Notification channels
CHANNEL_EMAIL=true
CHANNEL_BROWSER=true
CHANNEL_TELEGRAM=false
CHANNEL_WHATSAPP=false

# Default watchlist
DEFAULT_STATE="GJ"
DEFAULT_STATE_NAME="Gujarat"
DEFAULT_CITIES="Ahmedabad,Gandhinagar,Vadodara,Surat,Rajkot"
DEFAULT_KEYWORDS="cctv,surveillance,camera,installation,maintenance,security guard"
EXPORT_PAGE_SIZE=100

# Prisma
PRISMA_LOG=false